# Convex deployment URL (set by init_app_project tool or npx convex dev)
VITE_CONVEX_URL=

# For local development with npx convex dev
# CONVEX_DEPLOY_KEY=

# Auth private key (RSA 2048, generated automatically)
# AUTH_PRIVATE_KEY=

# ─── Teo sidecar ───
# Convex HTTP base, e.g. https://<deployment>.convex.site
TEO_DASHBOARD_URL=
# Shared secret guarding /teo/propose and /teo/decision.
# Set the SAME value on the Convex deployment:
#   bunx convex env set TEO_SHARED_SECRET "<random-string>"
TEO_SHARED_SECRET=
