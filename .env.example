# XAU Scalper — environment template. Copy to .env.local and fill in.
# Never commit .env.local — it is gitignored and holds secrets.

# Server
TEO_HOST=127.0.0.1
TEO_PORT=4000
TEO_DB_PATH=data/teo.db
TEO_JOURNAL_DAYS=90

# Market data (optional override; defaults to a public Binance mirror)
TEO_BINANCE_BASE_URL=https://data-api.binance.vision/api/v3

# Teo dashboard bridge (optional — only if Teo posts to the local server)
TEO_DASHBOARD_URL=http://127.0.0.1:4000
TEO_SHARED_SECRET=

# Kronos forecasting (optional)
TEO_KRONOS_LOCAL_DIR=models/kronos
TEO_KRONOS_DEVICE=cpu
